APP_NAME="Painel do Vendedor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3004

# Porta usada por "php artisan serve" e pelo Dockerfile (CONTRATOS secao 1)
PORT=3004

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Banco proprio do painel. Os nomes MYSQL_* sao os do CONTRATOS e sao lidos
# direto pela conexao "mysql" em config/database.php (nao existe DB_HOST aqui).
DB_CONNECTION=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=marketplace_seller

# APIs remotas que o painel consome com o JWT do vendedor
AUTH_URL=http://localhost:3003
CATALOG_URL=http://localhost:3001
ORDERS_URL=http://localhost:3002
ANALYTICS_URL=http://localhost:3005
REMOTE_TIMEOUT_S=5

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
CACHE_STORE=file
QUEUE_CONNECTION=sync

VITE_APP_NAME="${APP_NAME}"
